# blanks-relay configuration (all optional; defaults shown).
# Copy to .env and adjust. The relay holds no credentials or secrets.
# Bind address and port (terminate TLS in front; the relay itself is plain).
PORT=8080
BIND_HOST=0.0.0.0

# Room policy.
MAX_ROOM_PEERS=4
CODE_LENGTH=7
ROOM_IDLE_TIMEOUT_MS=1800000
SWEEP_INTERVAL_MS=15000

# Liveness: protocol-level pings; unresponsive sockets are closed
# (a lost host socket tears its room down).
HEARTBEAT_INTERVAL_MS=30000

# Abuse limits (per socket, both directions).
PACKET_LIMIT=65536
RATE_LIMIT_PER_SECOND=120
RATE_BURST=240
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32

# Optional comma-separated allowlist for browser-based clients.
# Leave empty for the game (native clients send no Origin header).
#ALLOWED_ORIGINS=https://example.com
