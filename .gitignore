# Godot
.godot/
*.translation

# Relay (Node.js) dependencies and local configuration
node_modules/
relay/.env

# Legacy EOS credential files stay ignored so old local copies never
# surface after the EOS removal (see ONLINE_SETUP.md)
eos_credentials.cfg
user_credentials.cfg

# Built-in music is local-only: players drop their own legally supplied
# tracks into audio/music/ (see audio/music/README.md); only that guide
# ships in the repository.
audio/music/*
!audio/music/README.md

# Exports
Exports/

# Local dev launcher (relay endpoint lives here; never commit)
launch_online_dev.ps1
export.cfg
export_credentials.cfg
*.pck
*.exe
